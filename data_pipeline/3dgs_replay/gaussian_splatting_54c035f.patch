+                            action_t = diff_action(prev_logged_state, curr_state, dt=dt, mode=ACTION_MODE)
+                            state_from = prev_logged_state
+
+                        # 위에서 계산한 총 loss를 그대로 사용 ( (1-λ)L1 + λ(1-SSIM) )
+                        loss_now = float(loss.detach().item())

+                        events = gaussians.pop_events()
+                        meta = {
+                            "scene": scene.model_path,
+                            "iter": int(iteration),
+                            "dt": int(dt),
+                            "log_every": int(LOG_EVERY)
+                        }
+                        logger.add_step(iteration, state_from, action_t, reward_t, events, meta)
+
+                        prev_logged_state = curr_state
+                        prev_logged_iter  = iteration
+                        prev_logged_loss  = loss_now
+                        prev_logged_count = n_now

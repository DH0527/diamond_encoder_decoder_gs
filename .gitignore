# ---------------------------------------------------------------------------
# can3tok .gitignore
# 원칙: 코드 · 문서 · 학습에 꼭 필요한 작은 자산만 추적한다.
#       체크포인트 · 로그 · 데이터 · 렌더 이미지는 서버에만 둔다 (SETUP_KR.md §9).
# ---------------------------------------------------------------------------

# 학습 산출물 (runs/ 는 약 200 GB)
runs/
*.pt
*.pth
*.ckpt
*.log
*.pid
train_metrics.jsonl

# 데이터 / 분석 번들
*.npz
*.ply
*.h5

# 렌더 이미지 · 발표 자료 (mdmd/ 의 PNG 만 220 MB)
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.pptx
*.ttf
*.otf
cmp_*/

# 편집 중 백업
*.bak
*.bak[0-9]*
*.bak_*
*.orig
*.rej
*~
Untitled

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# 에디터 / OS
.vscode/
.idea/
.DS_Store

# 비밀정보 (현재 없음 — 실수 방지용)
.env
.env.*
*.pem
*.key
.netrc

# ---------------------------------------------------------------------------
# 예외: 설계 설명용으로 꼭 필요한 그림 한 장
# ---------------------------------------------------------------------------
!proposal.png
